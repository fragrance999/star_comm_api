POSTGRES_USER=starcomm
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=starcomm

APP_NAME=star_comm_api
APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://starcomm:change-this-postgres-password@postgres:5432/starcomm
SQL_ECHO=false
SQL_ECHO_PARAMETERS=false
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

REGISTER_MODE=INVITE_OPTIONAL
CORS_ORIGINS=http://82.156.43.206

# DashScope OpenAI-compatible API. Set the real key only in deploy/production/.env.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
